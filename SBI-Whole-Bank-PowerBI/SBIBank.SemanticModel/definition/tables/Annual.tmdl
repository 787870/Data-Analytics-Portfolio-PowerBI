	measure 'Net Profit' = SUM ( Annual[NetProfitCr] )
		formatString: "#,0"
		displayFolder: Profit

	measure 'Deposits' = SUM ( Annual[DepositsCr] )
		formatString: "#,0"
		displayFolder: Balance sheet

	measure 'Advances' = SUM ( Annual[AdvancesCr] )
		formatString: "#,0"
		displayFolder: Balance sheet

	measure 'Net Profit FY26' = CALCULATE ( SUM ( Annual[NetProfitCr] ), Annual[FiscalYear] = "FY26" )
		formatString: "#,0"
		displayFolder: FY26 cards

	measure 'Deposits FY26' = CALCULATE ( SUM ( Annual[DepositsCr] ), Annual[FiscalYear] = "FY26" )
		formatString: "#,0"
		displayFolder: FY26 cards

	measure 'Advances FY26' = CALCULATE ( SUM ( Annual[AdvancesCr] ), Annual[FiscalYear] = "FY26" )
		formatString: "#,0"
		displayFolder: FY26 cards

	measure 'GNPA Ratio FY26' = CALCULATE ( SUM ( Annual[GNPA] ), Annual[FiscalYear] = "FY26" )
		formatString: "0.00%"
		displayFolder: FY26 cards

	partition Annual = m
		mode: import
		source =
			let
			    Source = #table(
			        type table [SortOrder = number, FiscalYear = text, DepositsCr = number, AdvancesCr = number, NIIcr = number, OperatingProfitCr = number, NetProfitCr = number, GNPA = number, NIM = number],
